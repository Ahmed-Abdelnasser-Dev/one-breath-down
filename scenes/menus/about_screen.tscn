[node name="FlavorLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
text = "You dive into the flooded remains of a civilization the sea swallowed long ago — broken statues, drowned colonnades, coral-reclaimed stonework. The deeper you go, the older and stranger the ruins become, and the more valuable — and dangerous — the pearls they still guard.

Every choice down there is measured against the one thing no upgrade can buy back: the breath you're already holding."
autowrap_mode = 3

